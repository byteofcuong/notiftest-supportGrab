# ─────────────────────────────────────────────────────────────────────────────
#  Mau bien moi truong. Copy file nay thanh `.env` roi dien gia tri that.
#  `.env` da duoc gitignore — KHONG BAO GIO commit no.
# ─────────────────────────────────────────────────────────────────────────────

# ── ccmany ───────────────────────────────────────────────────────────────────
# Endpoint nhan don. Bo trong thi coi nhu chua cau hinh va app se tu bat DRY_RUN.
CCMANY_API_URL=https://manage.ccmany.net/api/orders
CCMANY_API_KEY=
# Ma quan phia ccmany. Ma quan phia GRAB thi KHONG dien o day — app tu doc no
# tu tab Grab khi ban bam vao quan cua minh, roi ghi vao config/stores.json.
CCMANY_STORE_ID=STORE1

# CHE DO CHAY KHO. true  = chi ghi payload ra data/dry-run/ + Telegram, KHONG POST.
#                  false = gui that len ccmany.
# Giu true cho toi Task 11 (nghiem thu). Doi sang false la don thu se vao du lieu that.
DRY_RUN=true

# ── Telegram (tuy chon) ──────────────────────────────────────────────────────
# De trong thi bo qua toan bo phan Telegram, app van chay binh thuong.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Nhip poll ────────────────────────────────────────────────────────────────
# Cong web cua Grab poll 60s/lan. 5s la nhanh hon 12 lan, du de "gan nhu tuc thi".
# Toi thieu 3000 — thap hon nua loi it ma rui ro bi coi la bat thuong thi nhieu.
POLL_INTERVAL_MS=5000
# Khi open-status bao quan dang dong cua thi gian nhip ra (don khong the vao).
POLL_INTERVAL_CLOSED_MS=30000

# ── Chong gui trung ──────────────────────────────────────────────────────────
# Lop 2 cua co che chong trung: chi xu ly don co createdAt nam trong cua so nay
# tinh tu luc khoi dong. Mat file cache thi cung chi gui lai don trong khoang nay.
ORDER_LOOKBACK_MINUTES=15
# Tran so lan thu lai mot don loi, truoc khi bo qua va bao Telegram.
MAX_ORDER_ATTEMPTS=5

# ── Ben bi chay dai ngay ─────────────────────────────────────────────────────
# Tu reload trang Grab de don rac bo nho cua tab de mo lien tuc.
PAGE_RELOAD_MINUTES=60
# Khong co luot poll thanh cong nao trong ngan nay -> mo lai cua so Grab.
WATCHDOG_MINUTES=3
# Gui Telegram mot dong tinh trang moi ngan nay. 0 = tat.
HEARTBEAT_MINUTES=30
# Giu JSON tho cua don bao nhieu ngay roi tu xoa.
RAW_RETENTION_DAYS=14
# Tu chay cung Windows khi bat may. Chi co tac dung o ban da dong goi (.exe),
# o che do phat trien thi bi bo qua — dang ky duong dan electron.exe la vo nghia.
AUTO_START=true

# ── Chi dung khi phat trien ──────────────────────────────────────────────────
# Chu dong ngat mang cua phien Grab mot phut roi noi lai, de kiem chung kha nang
# tu phuc hoi ma khong phai rut day mang that. TUYET DOI khong bat tren may quan.
DEV_CHAOS=false

# ── Tuy chon dinh danh don ───────────────────────────────────────────────────
# Mac dinh order_number = orderID (ma dai, duy nhat tuyet doi).
# Bat co nay thi order_number = "GF-547-28082026" — de doc hon, van duy nhat.
# Chi bat neu ben van hanh ccmany muon vay.
ORDER_NUMBER_WITH_DATE=false

# ── Nhat ky ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
